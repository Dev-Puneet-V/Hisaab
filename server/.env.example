# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hisaab
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT_MS=5000

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars_for_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_min_32_chars_for_refresh
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins or * for dev)
CORS_ORIGIN=*
